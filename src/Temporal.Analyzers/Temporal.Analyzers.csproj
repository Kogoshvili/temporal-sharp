<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <!-- The DiagnosticAnalyzers only use compiler APIs, but the code fix
         providers in this assembly require Microsoft.CodeAnalysis.Workspaces,
         which trips RS1038. -->
    <NoWarn>$(NoWarn);RS1038</NoWarn>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <DevelopmentDependency>true</DevelopmentDependency>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <IncludeSymbols>false</IncludeSymbols>
    <RootNamespace>Kogoshvili.Temporal.Analyzers</RootNamespace>
    <PackageId>Kogoshvili.Temporal.Analyzers</PackageId>
    <Description>Part of the Kogoshvili.Temporal tool suite — Roslyn analyzer for determinism and SDK feature-misuse checks in the Temporal .NET SDK. Not affiliated with or endorsed by Temporal Technologies.</Description>
    <PackageTags>temporal;temporalio;roslyn;analyzer;workflows;determinism;static-analysis;csharp;dotnet</PackageTags>
    <PackageReleaseNotes>96 analyzer rules for workflow determinism, shared-state, and Temporal SDK feature misuse — see RULES.md in the repository for the full rule catalog.</PackageReleaseNotes>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(OutputPath)$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Temporal.Cli" />
  </ItemGroup>

</Project>
