<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>LatestMajor</RollForward>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>temporal-sharp</ToolCommandName>
    <RootNamespace>Kogoshvili.Temporal.Cli</RootNamespace>
    <PackageId>Kogoshvili.Temporal.Cli</PackageId>
    <Description>Part of the Kogoshvili.Temporal tool suite — standalone CLI for running the Kogoshvili.Temporal analyzer in CI. Not affiliated with or endorsed by Temporal Technologies.</Description>
    <PackageTags>temporal;temporalio;roslyn;analyzer;workflows;cli;static-analysis;csharp;dotnet</PackageTags>
    <PackageReleaseNotes>Initial beta release: standalone temporal-sharp CLI for running the Kogoshvili.Temporal analyzer.</PackageReleaseNotes>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" />
    <PackageReference Include="Microsoft.Build.Locator" />
    <!-- Override vulnerable transitive dependencies of MSBuildWorkspace. -->
    <PackageReference Include="System.Drawing.Common" />
    <!-- Azure.Core (via Temporal.Cloud) requires System.Text.Json >= 10.0.3. -->
    <PackageReference Include="System.Text.Json" VersionOverride="10.0.3" />
    <!-- Unify the Logging.Abstractions version pulled by MSBuildWorkspace (2.2.0),
         the Temporal SDK (6.0.0+), and Azure.Core (10.0.3). -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" VersionOverride="10.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Temporal.Analyzers\Temporal.Analyzers.csproj" />
    <ProjectReference Include="..\Temporal.Cloud\Temporal.Cloud.csproj" />
    <ProjectReference Include="..\Temporal.Configuration\Temporal.Configuration.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Temporal.Cli.Tests" />
  </ItemGroup>

</Project>
