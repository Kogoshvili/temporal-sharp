<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>LatestMajor</RollForward>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>temporal-sharp</ToolCommandName>
    <RootNamespace>Kogoshvili.Temporal.Cli</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>Kogoshvili.Temporal.Cli</PackageId>
    <Description>Part of the Kogoshvili.Temporal tool suite — standalone CLI for running the Kogoshvili.Temporal analyzer in CI. Not affiliated with or endorsed by Temporal Technologies.</Description>
    <PackageTags>temporal;temporalio;roslyn;analyzer;workflows;cli;static-analysis;csharp;dotnet</PackageTags>
    <PackageReleaseNotes>temporal-sharp CLI: run the Kogoshvili.Temporal analyzers (console/JSON/SARIF output) plus the map, history, docs, and preset commands.</PackageReleaseNotes>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" />
    <PackageReference Include="Microsoft.Build.Locator" />
    <!-- Elevate vulnerable transitive dependencies of MSBuildWorkspace to
         patched versions (versions pinned in Directory.Packages.props). The
         MSBuild.Tasks.Core reference is compile/audit-only: runtime MSBuild
         comes from the copy located by Microsoft.Build.Locator. -->
    <PackageReference Include="System.Drawing.Common" />
    <PackageReference Include="System.Formats.Asn1" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
    <PackageReference Include="System.Security.Cryptography.Xml" />
    <PackageReference Include="Microsoft.Build.Tasks.Core" ExcludeAssets="runtime" />
    <!-- Azure.Core (via Temporal.Cloud) requires System.Text.Json >= 10.0.3. -->
    <PackageReference Include="System.Text.Json" VersionOverride="10.0.3" />
    <!-- Unify the Logging.Abstractions version pulled by MSBuildWorkspace (2.2.0),
         the Temporal SDK (6.0.0+), and Azure.Core (10.0.3). -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" VersionOverride="10.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Temporal.Analyzers\Temporal.Analyzers.csproj" />
    <ProjectReference Include="..\Temporal.Cloud\Temporal.Cloud.csproj" />
    <ProjectReference Include="..\Temporal.Configuration\Temporal.Configuration.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Temporal.Cli.Tests" />
  </ItemGroup>

</Project>
