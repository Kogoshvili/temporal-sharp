<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Kogoshvili.Temporal.Configuration</RootNamespace>
    <PackageId>Kogoshvili.Temporal.Configuration</PackageId>
    <Description>Part of the Kogoshvili.Temporal tool suite — shared Temporal connection configuration for the Kogoshvili.Temporal.Hosting starter, the Kogoshvili.Temporal.Testing harness, and the temporal-sharp CLI. Loads a Temporal connection from appsettings.json or Temporal__* environment variables and builds an authenticated TemporalClient. Not affiliated with or endorsed by Temporal Technologies.</Description>
    <PackageTags>temporal;temporalio;configuration;connection;workflows;csharp;dotnet</PackageTags>
    <PackageReleaseNotes>Initial release: shared Temporal connection options and configuration loader.</PackageReleaseNotes>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="Temporalio" />
    <!-- Override vulnerable transitive dependency of Microsoft.Extensions.Configuration.Json. -->
    <PackageReference Include="System.Text.Json" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
