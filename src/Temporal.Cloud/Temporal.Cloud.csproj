<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Kogoshvili.Temporal.Cloud</RootNamespace>
    <PackageId>Kogoshvili.Temporal.Cloud</PackageId>
    <Description>Part of the Kogoshvili.Temporal tool suite — Azure and AWS integration for the Temporal .NET SDK: credential resolution and claim-check payload stores backed by Azure Blob Storage and Amazon S3. Not affiliated with or endorsed by Temporal Technologies.</Description>
    <PackageTags>temporal;temporalio;azure;aws;blob-storage;s3;claim-check;credentials;csharp;dotnet</PackageTags>
    <PackageReleaseNotes>Initial release: Azure/AWS credential resolution and Blob/S3 claim-check stores.</PackageReleaseNotes>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Identity" />
    <PackageReference Include="Azure.Security.KeyVault.Secrets" />
    <PackageReference Include="Azure.Storage.Blobs" />
    <PackageReference Include="AWSSDK.S3" />
    <PackageReference Include="AWSSDK.SecretsManager" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Temporal.Codec\Temporal.Codec.csproj" />
    <ProjectReference Include="..\Temporal.Configuration\Temporal.Configuration.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
