<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>LatestMajor</RollForward>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>temporal-sharp</ToolCommandName>
    <PackageId>TemporalSharp.Cli</PackageId>
    <Description>Standalone CLI for the TemporalSharp analyzer. Not affiliated with or endorsed by Temporal Technologies.</Description>
    <PackageTags>temporal;roslyn;analyzer;workflows;cli</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" />
    <PackageReference Include="Microsoft.Build.Locator" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TemporalSharp.Analyzers\TemporalSharp.Analyzers.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TemporalSharp.Cli.Tests" />
  </ItemGroup>

</Project>
